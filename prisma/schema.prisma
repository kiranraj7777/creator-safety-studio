generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified DateTime?
  image         String?
  role          String   @default("CREATOR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts           Account[]
  creatorProfiles    CreatorProfile[]
  connectedPlatforms ConnectedPlatform[]
  auditLogs          AuditLog[]
  evidencePacks      EvidencePack[]
  deletionRequests   DeletionRequest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model CreatorProfile {
  id          String   @id @default(cuid())
  userId      String
  displayName String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConnectedPlatform {
  id           String    @id @default(cuid())
  userId       String
  platform     String
  accountId    String
  accountName  String?
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  status       String    @default("ACTIVE")
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@unique([userId, platform, accountId])
}

model Comment {
  id                    String   @id @default(cuid())
  platform              String
  connectedPlatformId   String?
  accountId             String
  videoId               String
  commentId             String   @unique
  parentCommentId       String?
  authorDisplayNameEnc  String?
  authorHandleHash      String
  commentTextRaw        String?
  commentTextNormalized String?
  languageDetected      String?
  toxicScore            Float    @default(0)
  riskLabel             String   @default("low")
  matchedPhrases        String   @default("[]")
  confidence            Float    @default(0)
  reason                String?
  createdAt             DateTime @default(now())
  ingestedAt            DateTime @default(now())
  evidenceExpiresAt     DateTime
  isRetained            Boolean  @default(true)
  purgedAt              DateTime?

  connectedPlatform ConnectedPlatform? @relation(fields: [connectedPlatformId], references: [id], onDelete: Cascade)
  terms             CommentTerm[]

  @@index([authorHandleHash])
  @@index([videoId])
  @@index([riskLabel])
  @@index([evidenceExpiresAt])
}

model CommentTerm {
  id        String @id @default(cuid())
  commentId String
  term      String
  weight    Float

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
}

model AuthorProfile {
  id              String   @id @default(cuid())
  authorHandleHash String  @unique
  displayNameEnc  String?
  firstSeen       DateTime @default(now())
  lastSeen        DateTime @updatedAt
}

model OffenderRiskProfile {
  id               String   @id @default(cuid())
  authorHandleHash String   @unique
  uniqueVideos     Int      @default(0)
  totalComments    Int      @default(0)
  toxicComments    Int      @default(0)
  toxicityRatio    Float    @default(0)
  firstSeen        DateTime @default(now())
  lastSeen         DateTime @updatedAt
  topKeywords      String   @default("[]")
  repeatedPhrases  String?
  riskStatus       String   @default("low")
  updatedAt        DateTime @updatedAt

  @@index([riskStatus])
  @@index([toxicityRatio])
}

model EvidencePack {
  id          String   @id @default(cuid())
  userId      String
  platform    String
  videoId     String
  videoUrl    String?
  title       String?
  markdown    String
  jsonExport    String?
  reportText    String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model DeletionRequest {
  id               String   @id @default(cuid())
  userId           String
  authorHandleHash String
  status           String   @default("PENDING")
  reason           String?
  completedAt      DateTime?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DictionaryTerm {
  id        String   @id @default(cuid())
  term      String
  language  String   @default("en")
  category  String
  severity  Float    @default(0.5)
  isRegex   Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([term, language])
  @@index([language])
  @@index([active])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
